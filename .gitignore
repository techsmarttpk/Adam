# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Editors
.idea/
.vscode/
*.swp
.DS_Store

# Local config / secrets
.env
config/development.toml
config/production.toml

# Runtime output
artifacts/*
!artifacts/.gitkeep
logs/*
!logs/.gitkeep
*.sqlite
*.sqlite-wal
*.sqlite-shm

# Malware samples - never commit these
samples/*
!samples/.gitkeep
*.exe
*.dll
*.pcap
*.evtx
*.pml
