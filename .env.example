# Copy this file to .env and fill in real values.
# .env is gitignored (see .gitignore) and must never be committed.
#
# Guest credentials for the sandbox VM. Per ARCHITECTURE.md section 12.3,
# these must never appear in config/*.toml -- adam/common/config.py reads
# them exclusively from here / real environment variables.

ADAM__SANDBOX__GUEST_USERNAME=Admin
ADAM__SANDBOX__GUEST_PASSWORD=windows10
